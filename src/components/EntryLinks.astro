---
import { path } from '../lib/url';

interface Props {
	links: { label: string; href: string }[];
}

const { links } = Astro.props;
---

{
	links.length > 0 && (
		<ul class="entry-links">
			{links.map((link) => (
				<li>
					<a href={path(link.href)}>{link.label}</a>
				</li>
			))}
		</ul>
	)
}
