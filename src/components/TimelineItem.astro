---
import { formatPeriod } from '../lib/dates';

interface Props {
	title: string;
	summary?: string;
	start: string;
	end?: string;
	when?: string;
	org?: string;
	placeholder?: boolean;
	href?: string;
}

const { title, summary, start, end, when, org, placeholder, href } = Astro.props;
---

<article class="timeline-item">
	<p class="when">
		{when ?? formatPeriod(start, end)}
		{placeholder && <span class="pill accent">Placeholder</span>}
	</p>
	<h3>
		{
			href ? (
				<a href={href}>{title}</a>
			) : (
				title
			)
		}
	</h3>
	{org && <p class="org">{org}</p>}
	{summary && <p>{summary}</p>}
</article>
