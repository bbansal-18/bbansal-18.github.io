---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaceholderNote from '../components/PlaceholderNote.astro';
import Portrait from '../components/Portrait.astro';
import TagList from '../components/TagList.astro';
import { site } from '../data/site';

const about = await getEntry('pages', 'about');
if (!about) {
	throw new Error('Missing src/content/pages/about.md');
}
const { Content } = await render(about);
---

<BaseLayout title="About" description={`About ${site.name}, ${site.tagline}.`}>
	<article class="wrap page-head about-head">
		<div>
			<p class="kicker">About</p>
			<h1>{about.data.title}</h1>
			<p>{site.tagline}</p>
		</div>
		<Portrait class="about-portrait" width={360} />
	</article>
	<div class="wrap">
		<PlaceholderNote show={about.data.placeholder} />
		<div class="prose">
			<Content />
		</div>
		<section class="skill-block" aria-labelledby="skills-heading">
			<h2 id="skills-heading">My Skills</h2>
			<p>
				These are some skills that I consider myself proficient in, and some facts and hobbies that you may find interesting.
			</p>
			<div class="skill-grid">
				{
					site.skillGroups.map((group) => (
						<div>
							<h3>{group.heading}</h3>
							<TagList tags={group.items} />
						</div>
					))
				}
			</div>
		</section>
	</div>
</BaseLayout>
