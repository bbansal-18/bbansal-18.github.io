---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import { listed } from '../../lib/content';

const entries = await listed('projects');
---

<BaseLayout
	title="Projects"
	description="Things I built because a question or a gap needed a prototype."
>
	<header class="wrap page-head">
		<p class="kicker">Projects</p>
		<h1>Things I have built</h1>
		<p>Why each existed, what I made, and who it was for.</p>
	</header>
	<div class="wrap card-grid">
		{
			entries.map((entry) => (
				<EntryCard
					href={`/projects/${entry.id}/`}
					title={entry.data.title}
					summary={entry.data.summary}
					start={entry.data.start}
					end={entry.data.end}
					eyebrow={entry.data.tags[0]}
					placeholder={entry.data.placeholder}
				/>
			))
		}
	</div>
</BaseLayout>
