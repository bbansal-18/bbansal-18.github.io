---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { path } from '../lib/url';
---

<BaseLayout title="Not found" description="That page is not on this site.">
	<header class="wrap page-head">
		<p class="kicker">404</p>
		<h1>This page is not here</h1>
		<p>
			The link may be old, or the page has not been written yet. Start from the{' '}
			<a href={path('/')}>home page</a> or <a href={path('/about/')}>about {site.shortName}</a>.
		</p>
	</header>
</BaseLayout>
