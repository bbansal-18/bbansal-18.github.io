---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import { listed } from '../../lib/content';

const entries = await listed('experience');
---

<BaseLayout
	title="Work Experience"
	description="A list of experiences where I have learned things beyond the scope of any lecture I have attended."
>
	<header class="wrap page-head">
		<p class="kicker">Work Experience</p>
		<h1>Places I have worked</h1>
		<p>
			Internships through which I explored domains I never I knew I was interested in.
		</p>
	</header>
	<div class="wrap entry-list">
		{
			entries.map((entry) => (
				<EntryCard
					href={`/experience/${entry.id}/`}
					title={entry.data.role}
					summary={entry.data.summary}
					start={entry.data.start}
					end={entry.data.end}
					eyebrow={entry.data.org}
					placeholder={entry.data.placeholder}
				/>
			))
		}
	</div>
</BaseLayout>
