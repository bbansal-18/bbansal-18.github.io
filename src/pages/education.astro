---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaceholderNote from '../components/PlaceholderNote.astro';
import TagList from '../components/TagList.astro';
import { listed } from '../lib/content';
import { formatPeriod } from '../lib/dates';

const entries = await listed('education');
---

<BaseLayout
	title="Education"
	description="B.S. Computer Science at Carnegie Mellon University, with earlier schooling in Ludhiana."
>
	<header class="wrap page-head">
		<p class="kicker">Education</p>
		<h1>Computer Science at Carnegie Mellon</h1>
		<p>
			B.S. in Computer Science, with minors in machine learning and mathematical finance.
			Expected May 2028. Earlier: Sat Paul Mittal School, Ludhiana — ISC state topper, 98.8%.
		</p>
	</header>
	<div class="wrap stack">
		{
			entries.map(async (entry) => {
				const { Content } = await render(entry);
				return (
					<article class="education-card">
						<p class="date-label">
							{formatPeriod(entry.data.start, entry.data.end)}
							{entry.data.placeholder && <span class="pill accent">Placeholder</span>}
						</p>
						<h2>{entry.data.school}</h2>
						<p class="degree">
							{entry.data.degree}
							{entry.data.location ? ` · ${entry.data.location}` : ''}
						</p>
						<PlaceholderNote show={entry.data.placeholder} />
						<div class="prose">
							<Content />
						</div>
						{entry.data.highlights.length > 0 && (
							<>
								<p class="degree">Selected coursework and notes</p>
								<TagList tags={entry.data.highlights} />
							</>
						)}
					</article>
				);
			})
		}
	</div>
</BaseLayout>
